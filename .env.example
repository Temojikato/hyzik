# Client-side feature switch. Never put an OpenAI key in a REACT_APP variable.
REACT_APP_ENABLE_IMAGE_GENERATION=true

# Admin-only local scripts
GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\outside-the-repository\\firebase-service-account.json
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
